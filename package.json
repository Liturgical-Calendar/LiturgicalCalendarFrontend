{
  "name": "liturgical-calendar-frontend",
  "packageManager": "yarn@4.17.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint .",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:chromium": "playwright test --project=chromium",
    "test:firefox": "playwright test --project=firefox",
    "test:webkit": "playwright test --project=webkit",
    "test:report": "playwright show-report",
    "test:ci": "CI=true playwright test",
    "test:ci:chromium": "CI=true playwright test --project=chromium",
    "test:install": "playwright install --with-deps",
    "tsc": "tsc",
    "typecheck": "tsc -p e2e/tsconfig.json --noEmit",
    "lint:md": "markdownlint-cli2 \"**/*.md\" \"#node_modules\" \"#.yarn\" \"#**/vendor/**\"",
    "lint:md:fix": "markdownlint-cli2 --fix \"**/*.md\" \"#node_modules\" \"#.yarn\" \"#**/vendor/**\"",
    "format:md": "prettier --write \"**/*.md\" \"!node_modules/**\" \"!.yarn/**\" \"!**/vendor/**\""
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@playwright/test": "^1.61.0",
    "@types/node": "^24.10.1",
    "dotenv": "^17.4.2",
    "eslint": "^9.32.0",
    "globals": "^16.3.0",
    "markdownlint-cli2": "^0.22.1",
    "prettier": "^3.4.2",
    "typescript": "^5.9.3"
  },
  "resolutions": {
    "js-yaml": "^4.2.0"
  }
}
