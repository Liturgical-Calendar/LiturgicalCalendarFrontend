# valid values: development, test, staging, production
APP_ENV=development

##
# API Configuration
# These variables define where the Frontend looks for the API
# (they do not control where the API actually runs)
##
API_PROTOCOL=http
API_HOST=localhost
API_PORT=8000
# API Base Path - the path prefix for all API endpoints
# In production, this is typically /api/dev or /api/v5
# In local development, leave empty (API runs at root)
API_BASE_PATH=

##
# Debug Configuration
##
# Enable verbose debug logging (true/false)
DEBUG_MODE=false

##
# JWT Authentication Configuration
# These must match the API's JWT settings to validate tokens server-side
# This enables server-side auth state detection, avoiding UI flash on page load
##
JWT_SECRET=change-this-to-a-secure-random-string-in-production-minimum-32-chars
JWT_ALGORITHM=HS256

##
# Cookie Configuration
# Optional: Set domain for auth cookies (for cross-subdomain sharing)
# Leave empty to use current domain (default browser behavior)
# Example: .example.com (note leading dot for subdomain inclusion)
##
# COOKIE_DOMAIN=

##
# Related Project URLs
##
# Accuracy Tests Interface URL (UnitTestInterface)
ACCURACY_TESTS_URL=http://localhost:3003

##
# Playwright E2E Test Configuration
# These credentials are used by e2e tests to authenticate with the API
# They should match a valid user in your API's authentication system
##
FRONTEND_URL=http://localhost:3000
# Path to API repository (defaults to ../LiturgicalCalendarAPI)
# API_REPO_PATH=/path/to/LiturgicalCalendarAPI
TEST_USERNAME=testuser
TEST_PASSWORD=testpassword

##
# Zitadel OIDC Configuration (for RBAC)
# Configure after setting up Zitadel via docker compose
# Run ./scripts/setup-zitadel.sh --update-env to populate these automatically
# ISSUER: Your Zitadel instance URL (e.g., http://localhost:8080)
# CLIENT_ID: Application client ID from Zitadel console
# PROJECT_ID: Project ID containing roles for RBAC
##
# ZITADEL_ISSUER=http://localhost:8080
# ZITADEL_CLIENT_ID=your-frontend-client-id
# ZITADEL_PROJECT_ID=your-project-id

##
# Docker Compose Port Configuration
# These variables control which HOST ports are exposed when using docker compose.
# They only affect the host-side port mapping — container-internal ports are fixed.
#
# How it works:
#   ports: "127.0.0.1:${API_PORT:-8000}:8000"
#                       ^^^^^^^^^^^^^^^^ ^^^^
#                       host port        container port (fixed)
#
# Changing a port here changes where the service is reachable on your machine,
# but does NOT change the port the service listens on inside its container.
# For example, setting API_PORT=9000 makes the API available at localhost:9000
# while internally the container still serves on port 8000.
#
# When running WITHOUT Docker (php -S localhost:3000), these variables are not
# used for port binding — you specify the port directly on the command line.
# However, API_PORT is still read by the frontend application to build API URLs.
##
# FRONTEND_PORT=3000
# API_PORT=8000
# WS_PORT=8082
# TESTS_PORT=3003
# DB_PORT=5432
# ADMINER_PORT=8088
