# dotenv-linter:off UnorderedKey
# ^ Intentional: keys in this file are grouped by purpose and ordered
# by operational importance (REQUIRED blocks first, optional ones
# after), NOT alphabetically. Suppresses dotenv-linter's UnorderedKey
# rule (and CodeRabbit's surfacing of it) for the whole file.

##
# Copy to .env.local (dev), .env.staging (staging), or .env.production
# (prod) depending on your deployment.
#
# Loaded by auth/*.php in this order (FIRST match wins):
#   .env.local → .env.development → .env.staging → .env.production → .env
##

##
# REQUIRED — Application environment
# Valid values: development, test, staging, production.
# Gates dev-only behavior — e.g., layout/footer.php switches the
# components-js importmap target to the local ./assets/components-js/
# symlink ONLY when APP_ENV === 'development'. Staging and production
# fall through to the jsDelivr CDN. If unset, code reading $_ENV['APP_ENV']
# defaults to 'production' (safe), which means the local symlink won't be
# tried — set this explicitly to 'development' in your local .env.
##
APP_ENV=development

##
# REQUIRED — Frontend public URL
# Used at RUNTIME by:
#   - OidcClient::fromEnv() to construct the OIDC redirect URI
#     (<FRONTEND_URL>/auth/callback.php) when no override is passed
#   - auth/callback.php to validate post-login return_to URLs (same-origin)
#   - auth/logout.php for post-logout redirects
# Also used by Playwright e2e tests as the base URL under test.
# Without this, /auth/login.php returns HTTP 500:
#   {"error":"Failed to initialize OIDC client"}
##
FRONTEND_URL=http://localhost:3000

##
# REQUIRED — API endpoint
# Tells the Frontend where to reach the API (these do NOT control
# where the API itself listens). Every page that talks to the API
# (calendar lookups, auth flows, admin endpoints) builds its URLs
# from these four values; misconfigure them and the frontend renders
# but can't fetch anything.
#
# API_BASE_PATH is the path prefix for all API endpoints:
#   - production / staging: typically /api/v5 or /api/dev
#   - local development:    leave empty (API runs at root)
##
# Transport policy (issue #495): when API_HOST is not a loopback address and
# APP_ENV is neither `development` nor `test`, API_PROTOCOL must be `https` or the
# frontend refuses to start. Pages send session cookies with `credentials:
# 'include'`, so plaintext against a remote host would expose them.
#
# Set API_HTTPS_ENFORCEMENT=false to opt out where TLS terminates in front of the
# deployment (a load balancer or reverse proxy), mirroring the API's own
# HTTPS_ENFORCEMENT setting. Loopback hosts and local APP_ENV values are exempt
# automatically, so the development defaults below need no opt-out.
#API_HTTPS_ENFORCEMENT=true
API_PROTOCOL=http
API_HOST=localhost
API_PORT=8000
API_BASE_PATH=

##
# Debug Configuration
##
# Enable verbose debug logging (true/false)
DEBUG_MODE=false

##
# REQUIRED — JWT validation
# JWT_SECRET MUST match the API's JWT_SECRET so the frontend can verify
# the auth cookie set by the API server-side (HS256 default). This is
# what enables auth-state detection at PHP render time, avoiding the
# logged-out → logged-in UI flash on first paint.
# A mismatch silently breaks session validation — pages render as if
# the user is logged out even when a valid cookie is present.
##
JWT_SECRET=change-this-to-a-secure-random-string-in-production-minimum-32-chars
JWT_ALGORITHM=HS256

##
# Cookie Configuration
# Optional: Set domain for auth cookies (for cross-subdomain sharing)
# Leave empty to use current domain (default browser behavior)
# Example: .example.com (note leading dot for subdomain inclusion)
##
# COOKIE_DOMAIN=

##
# Related Project URLs
##
# Accuracy Tests Interface URL (UnitTestInterface)
ACCURACY_TESTS_URL=http://localhost:3003

##
# Playwright E2E Test Configuration
# The suite needs no credentials of its own: e2e/auth.setup.ts seeds a Zitadel
# administrator and logs it in through the OIDC flow, using the ZITADEL_* settings
# below. (It used to authenticate with a TEST_USERNAME/TEST_PASSWORD pair against
# the API's legacy HS256 /auth/login — see issue #448 for why that stopped working.)
##
# Path to API repository (defaults to ../LiturgicalCalendarAPI)
# API_REPO_PATH=/path/to/LiturgicalCalendarAPI

##
# REQUIRED — Zitadel OIDC (sign-in flow)
# Run ./scripts/setup-zitadel.sh --update-env in dev to populate these
# automatically; in staging/prod, set them by hand from the values
# emitted by the umbrella's setup-zitadel.sh --provision-litcal-frontend.
#
# ZITADEL_CLIENT_ID must be the FRONTEND (Web/PKCE) app's client_id,
# distinct from the API backend's PRIVATE_KEY_JWT app — DO NOT cross-wire.
# Without ZITADEL_ISSUER + ZITADEL_CLIENT_ID, /auth/login.php returns
# HTTP 503: {"error":"OIDC not configured"}
# ZITADEL_PROJECT_ID is optional — used for RBAC project-role lookups.
#
# ZITADEL_ORG_ID is STRONGLY RECOMMENDED in shared Zitadel instances.
# When set, OidcClient appends the `urn:zitadel:iam:org:id:<id>` scope
# to every authorization request, forcing both login AND new-user
# registration into that specific org. Without it, the hosted login
# lands new passkey/email registrations in Zitadel's IAM-internal
# default org, which carries no project roles — the user appears
# "registered" but has no RBAC permissions and is invisible to
# org-scoped admin APIs.
##
ZITADEL_ISSUER=http://localhost:8080

# The OIDC client for litcal-tests, which is NOT the one below. Zitadel rejects any
# redirect_uri that is not registered against the client making the request, and the
# test interface's callback is on its own port and therefore registered only against its
# own client. So if litcal-tests is given ZITADEL_CLIENT_ID — the Frontend's client —
# its login fails with:
#     The requested redirect_uri is missing in the client configuration.
# `scripts/setup-zitadel.sh --update-env` writes this into .env. Left unset,
# docker-compose.yml falls back to ZITADEL_CLIENT_ID, so the stack still boots and only
# the test interface's login breaks.
# ZITADEL_TESTS_CLIENT_ID=
ZITADEL_CLIENT_ID=your-frontend-client-id
# ZITADEL_PROJECT_ID=your-project-id
# ZITADEL_ORG_ID=your-zitadel-org-id

# Machine (service-account) PAT for Zitadel's management API. Written by
# setup-zitadel.sh --update-env. Required by the RBAC E2E suite only — its
# helpers create, find and delete seeded users through the management API
# (e2e/rbac/support/zitadel.ts). The app itself never uses it.
#
# It goes STALE whenever Zitadel's volumes are wiped (docker compose down -v).
# The API healthcheck does not exercise Zitadel, so litcal-api still reports
# healthy while holding an invalid PAT; re-run with --force-secrets, then
# recreate litcal-api, litcal-frontend and litcal-tests so they re-read .env.
# ZITADEL_MACHINE_TOKEN=

##
# Docker Compose Port Configuration
# These variables control which HOST ports are exposed when using docker compose.
# They only affect the host-side port mapping — container-internal ports are fixed.
#
# How it works:
#   ports: "127.0.0.1:${API_PORT:-8000}:8000"
#                       ^^^^^^^^^^^^^^^^ ^^^^
#                       host port        container port (fixed)
#
# Changing a port here changes where the service is reachable on your machine,
# but does NOT change the port the service listens on inside its container.
# For example, setting API_PORT=9000 makes the API available at localhost:9000
# while internally the container still serves on port 8000.
#
# When running WITHOUT Docker (php -S localhost:3000), these variables are not
# used for port binding — you specify the port directly on the command line.
# However, API_PORT is still read by the frontend application to build API URLs.
##
# FRONTEND_PORT=3000
# API_PORT=8000
# WS_PORT=8082
# TESTS_PORT=3003
# DB_PORT=5432
# ADMINER_PORT=8088
# MAILPIT_PORT=8025
# OPENFGA_HTTP_PORT=8083
# OPENFGA_GRPC_PORT=8084
# OPENFGA_PLAYGROUND_PORT=3001
# ZITADEL_PORT=8080
# ZITADEL_LOGIN_PORT=8081
#
# ZITADEL_PORT moves three things at once, because they must agree: the published
# host port, ZITADEL_EXTERNALPORT, and the OIDC issuer handed to litcal-api,
# litcal-frontend and litcal-tests. ZITADEL_LOGIN_PORT does the same for the
# login-v2 UI. They were hardcoded until it turned out a desktop app can quietly
# take 8080 (see below); the DEFAULTS ARE UNCHANGED, so overriding nothing behaves
# exactly as before.
#
# IF YOU OVERRIDE ZITADEL_PORT, also remove or update ZITADEL_ISSUER in this file.
# An explicit ZITADEL_ISSUER wins over the port-derived default — deliberately, so
# a non-localhost deployment can point at a real domain — which means a stale
# ZITADEL_ISSUER=http://localhost:8080 silently survives a port change and
# reintroduces exactly the disagreement the variable exists to prevent.
# `scripts/setup-zitadel.sh --update-env` derives it from ZITADEL_PORT and writes it into
# `.env` — the file docker compose interpolates by default, unless you pass --env-file.
# It did not always: it wrote only to whatever resolve_env_file() picks (.env.local, else
# .env.development, else .env). When that landed on .env the stack was configured; when a
# .env.local or .env.development existed it took precedence, .env was left untouched, and
# a stale value there stood. Fixed in LiturgicalCalendarAPI#890.
#
# What is NOT parameterized, on purpose — two different settings owned by
# different services, so check which one you are about to change:
#   - ZITADEL_API_URL=http://localhost:8080   is on the `login` service only. Its
#     network_mode puts it inside Zitadel's namespace, so this is Zitadel's own
#     container port.
#   - ZITADEL_INTERNAL_URL=http://zitadel:8080 is on `litcal-api` and
#     `litcal-frontend`. The `login` service does not read it.
# Both name Zitadel's container port, which never moves, so neither follows
# ZITADEL_PORT.
#
# If something else on the host already holds 8080, docker does NOT fail with
# "port is already allocated" here — it creates and starts the container WITHOUT
# that binding. Verified on this stack: with a listener occupying 127.0.0.1:8080,
# `docker compose up -d --force-recreate zitadel` exits 0, `docker compose ps`
# reports "healthy", and only the inspect below reveals the missing mapping. So
# every host-side Zitadel call fails while the stack looks fine. Confirm with:
#   docker compose ps -q zitadel | xargs docker inspect \
#     --format '{{json .NetworkSettings.Ports}}'
# An empty "8080/tcp":[] means the port was taken. Free it (or set ZITADEL_PORT),
# then recreate — INCLUDING `login`:
#   docker compose up -d --force-recreate zitadel login litcal-api litcal-frontend litcal-tests
#
# `login` is easy to leave out and must not be: it uses `network_mode: service:zitadel`,
# which docker pins as a CONTAINER ID, not a service name. Recreating zitadel alone
# gives it a new id and a new network namespace, leaving login attached to the
# destroyed one — nothing then listens on the login UI port and the browser gets
# ERR_EMPTY_RESPONSE from a stack that still reports every container healthy.

# Mailpit REST API base URL (local email capture). Used by the RBAC E2E
# registration specs to read Zitadel verification emails. Default: http://localhost:8025
MAILPIT_API_URL=http://localhost:8025

##
# OpenFGA — fine-grained authorization store. Required by the RBAC E2E suite
# (e2e/rbac/support/fga.ts), which writes and deletes relationship tuples to set
# up scoped-permission scenarios. Not used by the frontend app itself.
#
# OPENFGA_API_URL is written by setup-zitadel.sh --update-env. Its host port must
# track OPENFGA_HTTP_PORT above (default 8083) — override that and this URL, plus
# the snippet below, have to follow. The container itself always listens on 8080,
# so only the host side moves. A port matching neither (18083, say) shows up only
# as a connection-refused inside rbac-setup.
#
# STORE_ID and MODEL_ID are NOT written by any script: they are generated when
# the stack first provisions OpenFGA, so they change every time its volumes are
# wiped. A stale pair fails as
#   FGA write 400: {"code":"authorization_model_not_found", ...}
# which is easy to misread as a permissions problem. Re-resolve them from the
# running stack — this is exactly what .github/workflows/e2e.yml does:
#
#   fga="http://localhost:${OPENFGA_HTTP_PORT:-8083}"
#   store=$(curl -sS "$fga/stores" \
#     | python3 -c "import sys,json;s=json.load(sys.stdin)['stores'];print(s[0]['id'])")
#   model=$(curl -sS "$fga/stores/$store/authorization-models" \
#     | python3 -c "import sys,json;m=json.load(sys.stdin)['authorization_models'];print(m[0]['id'])")
#
# The containers read the same pair from .env (with the in-network
# OPENFGA_API_URL=http://openfga:8080); keep the two files in step, and recreate
# litcal-api after changing .env, since compose only re-reads it on create.
##
OPENFGA_API_URL=http://localhost:8083
# OPENFGA_STORE_ID=
# OPENFGA_MODEL_ID=

# Internal URL for server-side frontend->API calls (e.g. AuthHelper GET /auth/admin-scopes).
# Needed in containerized/Docker deploys where API_HOST (the public host) is not reachable from
# within the frontend container. Unset in single-host deploys (falls back to the public API URL).
# Local Docker stack: http://litcal-api:8000
# API_INTERNAL_URL=
